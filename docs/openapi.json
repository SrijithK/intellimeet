  "info": {
    "description": "Ingest meeting transcripts and ask questions about discussions, decisions and action items. Answers are grounded in the transcripts and cite `[meeting, hh:mm:ss, speaker]`.",
    "title": "IntelliMeet API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/chat": {
      "post": {
        "description": "Answers a question from the meeting transcripts as a stream of\n[Server-Sent Events](https://html.spec.whatwg.org/multipage/server-sent-events.html):\n\n1. `event: citations`: `CitationsEvent`, every source the answer may cite\n2. `event: token` (repeated): `TokenEvent`, answer text with citations rendered as `[meeting, hh:mm:ss, speaker]`\n3. `event: done`: `DoneEvent`, the full answer, cited sources and usage; or `event: error`: `ErrorEvent`\n\nEach event's `data:` line is JSON. When nothing relevant is found, the answer is a fixed\n\"couldn't find\" sentence and `done.found` is `false`.",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "example": "event: citations\ndata: {\"sources\": [...]}\n\nevent: token\ndata: {\"text\": \"The launch moved to November 17th \"}\n\nevent: token\ndata: {\"text\": \"[product-launch-planning, 00:01:44, Priya].\"}\n\nevent: done\ndata: {\"answer\": \"...\", \"found\": true, ...}\n\n",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Event stream"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask a question (streamed)",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "operationId": "get_job_api_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
