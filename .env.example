# Postgres (docker compose maps the container to host port 5433)
DATABASE_URL=postgresql+psycopg://intellimeet:intellimeet@localhost:5433/intellimeet

# Used by pytest; created automatically if it does not exist
TEST_DATABASE_URL=postgresql+psycopg://intellimeet:intellimeet@localhost:5433/intellimeet_test

# LLM (structured extraction now; answers later). Only "ollama" is implemented so far.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Ollama silently truncates prompts beyond its context window; keep this explicit.
OLLAMA_NUM_CTX=8192
EXTRACTION_ENABLED=true
LOG_LEVEL=INFO

# Ingested on API startup (idempotent); docker compose mounts ./data/transcripts here
# SEED_DIR=../data/transcripts
